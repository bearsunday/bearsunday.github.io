{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bearsunday.github.io/schemas/source-xref.schema.json",
  "title": "Source to manual cross-reference",
  "description": "Maps a source file on GitHub to the manual sections that explain it. Generated by bin/gen_source_xref.php from the `@see` manual URLs in the source docblocks.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri"
    }
  },
  "propertyNames": {
    "anyOf": [
      {"const": "$schema"},
      {"pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/blob/[^/]+/.+\\.php$"}
    ]
  },
  "additionalProperties": {
    "type": "array",
    "minItems": 1,
    "uniqueItems": true,
    "items": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://bearsunday\\.github\\.io/manuals/1\\.0/en/[A-Za-z0-9_.-]+\\.html#[A-Za-z0-9_-]+$"
    }
  }
}
